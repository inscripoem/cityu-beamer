% SPDX-License-Identifier: MIT
% CityU branding assets are covered separately in NOTICE.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeCityU}[2026/09/08 v1.0.1 CityU January 2025 presentation theme]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{beamerthemeCityU}{This theme requires XeLaTeX}
    {Select XeLaTeX in your editor or in Overleaf's compiler settings.}
\fi
% Scalable Latin Modern mathematics also supports the 24 pt cover title.
\RequirePackage{lmodern}
\RequirePackage[no-math]{fontspec}
\RequirePackage{tikz}
\RequirePackage{etoolbox}

\mode<presentation>

\newif\ifcityu@sectionpages
\newif\ifcityu@showfooter
\cityu@sectionpagestrue
\cityu@showfootertrue
\def\cityu@assetspath{assets}

\DeclareOptionBeamer{sectionpages}[true]{%
  \ifstrequal{#1}{true}{\cityu@sectionpagestrue}{%
    \ifstrequal{#1}{false}{\cityu@sectionpagesfalse}{%
      \PackageError{beamerthemeCityU}{sectionpages must be true or false}{}% 
    }%
  }%
}
\DeclareOptionBeamer{footer}[true]{%
  \ifstrequal{#1}{true}{\cityu@showfootertrue}{%
    \ifstrequal{#1}{false}{\cityu@showfooterfalse}{%
      \PackageError{beamerthemeCityU}{footer must be true or false}{}% 
    }%
  }%
}
\DeclareOptionBeamer{assetspath}{\def\cityu@assetspath{#1}}
\ProcessOptionsBeamer

\definecolor{CityURed}{HTML}{B60007}
\definecolor{CityUInk}{HTML}{25262B}
\definecolor{CityUMuted}{HTML}{666A73}
\definecolor{CityULine}{HTML}{DDDDE2}
\definecolor{CityUPaper}{HTML}{F5F5F7}
\definecolor{CityUTeal}{HTML}{12746B}

% File-based font selection also works without fonts registered in Windows.
\setsansfont{texgyreheros}[
  Extension=.otf,
  UprightFont=*-regular,
  BoldFont=*-bold,
  ItalicFont=*-italic,
  BoldItalicFont=*-bolditalic,
  Ligatures=TeX
]
\setmainfont{texgyretermes}[
  Extension=.otf,
  UprightFont=*-regular,
  BoldFont=*-bold,
  ItalicFont=*-italic,
  BoldItalicFont=*-bolditalic,
  Ligatures=TeX
]
\setmonofont{texgyrecursor}[
  Extension=.otf,
  UprightFont=*-regular,
  BoldFont=*-bold,
  ItalicFont=*-italic,
  BoldItalicFont=*-bolditalic,
  Scale=MatchLowercase
]
\usefonttheme{professionalfonts}

\setbeamercolor{normal text}{fg=CityUInk,bg=white}
\setbeamercolor{structure}{fg=CityURed}
\setbeamercolor{title}{fg=CityURed}
\setbeamercolor{subtitle}{fg=CityUMuted}
% Leave the background transparent so the PPT's top-right logo stays visible.
\setbeamercolor{frametitle}{fg=CityURed,bg=}
\setbeamercolor{framesubtitle}{fg=CityUMuted}
\setbeamercolor{section title}{fg=CityURed}
\setbeamercolor{footline}{fg=CityUMuted,bg=white}
\setbeamercolor{alerted text}{fg=CityURed}
\setbeamercolor{example text}{fg=CityUTeal}
\setbeamercolor{block title}{fg=CityURed,bg=CityURed!7!white}
\setbeamercolor{block body}{fg=CityUInk,bg=CityUPaper}
\setbeamercolor{block title alerted}{fg=white,bg=CityURed}
\setbeamercolor{block body alerted}{fg=CityUInk,bg=CityURed!4!white}
\setbeamercolor{block title example}{fg=CityUTeal,bg=CityUTeal!9!white}
\setbeamercolor{block body example}{fg=CityUInk,bg=CityUPaper}

\setbeamerfont{title}{size=\fontsize{24}{28},series=\bfseries}
\setbeamerfont{subtitle}{size=\fontsize{11}{14},series=\mdseries}
\setbeamerfont{author}{size=\fontsize{11}{14},series=\bfseries}
\setbeamerfont{institute}{size=\fontsize{9}{12},series=\mdseries}
\setbeamerfont{date}{size=\fontsize{9}{12},series=\mdseries}
\setbeamerfont{frametitle}{size=\fontsize{20}{23},series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{9}{11},series=\mdseries}
\setbeamerfont{section title}{size=\fontsize{23}{27},series=\bfseries}
\setbeamerfont{section number}{size=\fontsize{11}{14},series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{footline}{size=\fontsize{7}{9},series=\mdseries}
\setbeamerfont{caption}{size=\footnotesize}

\setbeamersize{text margin left=1cm,text margin right=1cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{sections/subsections in toc}[sections numbered]
\setbeamertemplate{blocks}[default]
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{bibliography item}[text]
\hypersetup{colorlinks=true,urlcolor=CityURed,linkcolor=CityURed}

\newcommand{\cityufooter}[1]{\def\cityu@footer{#1}}
\def\cityu@footer{\insertshorttitle}

\newcommand{\cityu@background}[1]{%
  \includegraphics[width=\paperwidth,height=\paperheight]{\cityu@assetspath/#1.png}%
}
% Used inside special-page TikZ pictures so native \titlepage also gets its art.
\newcommand{\cityu@pageart}[1]{%
  \node[anchor=south west,inner sep=0pt] at (current page.south west)
    {\cityu@background{#1}};
}
\setbeamertemplate{background canvas}{\cityu@background{content}}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vskip0.75cm
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1cm,rightskip=3.2cm plus 1fil,sep=0pt]{frametitle}
    \usebeamerfont{frametitle}\strut\insertframetitle\strut\par
    \ifx\insertframesubtitle\@empty\else
      \vskip0.6mm
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi
  \end{beamercolorbox}
  % Rebalance spacing above the title without pushing dense content off-page.
  \vskip0pt
}

\setbeamertemplate{footline}{%
  \ifcityu@showfooter
    \leavevmode
    \hbox to \paperwidth{\hskip1cm\color{CityULine}\rule{\dimexpr\paperwidth-2cm\relax}{0.3pt}\hfil}%
    \vskip1mm
    \hbox{%
      \begin{beamercolorbox}[wd=.83\paperwidth,leftskip=1cm,rightskip=2mm,sep=0pt]{footline}
        \hypersetup{linkcolor=CityUMuted}% Beamer links the short title to the cover.
        \usebeamerfont{footline}\strut\cityu@footer\par
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.17\paperwidth,right,rightskip=1cm,sep=0pt]{footline}
        \usebeamerfont{footline}\strut\insertframenumber\,/\,\inserttotalframenumber
      \end{beamercolorbox}%
    }%
    \vskip1.6mm
  \fi
}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \cityu@pageart{title}
    \node[anchor=north west,inner sep=0pt,text width=.71\paperwidth,align=left]
      at ([xshift=.069\paperwidth,yshift=-.28\paperheight]current page.north west) {%
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
        \ifx\insertsubtitle\@empty\else
          \vspace{3mm}{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
        \fi
      };
    \node[anchor=north west,inner sep=0pt,text width=.60\paperwidth,align=left]
      at ([xshift=.069\paperwidth,yshift=-.70\paperheight]current page.north west) {%
        {\usebeamerfont{author}\insertauthor\par}%
        \ifx\insertinstitute\@empty\else
          \vspace{1mm}{\usebeamerfont{institute}\insertinstitute\par}%
        \fi
        \ifx\insertdate\@empty\else
          \vspace{2mm}{\usebeamerfont{date}\color{CityUMuted}\insertdate\par}%
        \fi
      };
  \end{tikzpicture}%
}

\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \cityu@pageart{section}
    \node[anchor=north west,inner sep=0pt,text width=.67\paperwidth,align=left]
      at ([xshift=.069\paperwidth,yshift=-.59\paperheight]current page.north west) {%
        {\usebeamerfont{section number}\color{CityUMuted}%
          \ifnum\insertsectionnumber<10 0\fi\insertsectionnumber\par}%
        \vspace{1.8mm}%
        {\usebeamerfont{section title}\usebeamercolor[fg]{section title}\insertsectionhead\par}%
      };
  \end{tikzpicture}%
}

\newcommand{\cityutitlepage}{%
  \begingroup
    \setbeamertemplate{background canvas}{}%
    \begin{frame}[plain,noframenumbering]\titlepage\end{frame}%
  \endgroup
}

\newcommand{\cityusectionpage}{%
  \begingroup
    \setbeamertemplate{background canvas}{}%
    \begin{frame}[plain,noframenumbering]\sectionpage\end{frame}%
  \endgroup
}

\newcommand{\cityuclosing}[2][]{%
  \begingroup
    \setbeamertemplate{background canvas}{}%
    \begin{frame}[plain,noframenumbering]
      \begin{tikzpicture}[remember picture,overlay]
        \cityu@pageart{closing}
        \node[inner sep=0pt,text width=.80\paperwidth,align=center]
          at ([yshift=.06\paperheight]current page.center) {%
            {\usebeamerfont{title}\usebeamercolor[fg]{title}#2\par}%
            \ifstrempty{#1}{}{%
              \vspace{4mm}{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}#1\par}%
            }%
          };
      \end{tikzpicture}
    \end{frame}%
  \endgroup
}

\AtBeginSection[]{\ifcityu@sectionpages\cityusectionpage\fi}

\mode<all>
